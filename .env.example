# Copy file này thành .env.local rồi điền giá trị thật (KHÔNG commit .env.local)
#
# Lấy 4 giá trị VITE_FIREBASE_* ở:
# Firebase Console → Project settings (bánh răng) → General → "Your apps" → Web app → SDK setup and configuration → Config

# firebaseConfig.apiKey
VITE_FIREBASE_API_KEY=

# firebaseConfig.authDomain  (dạng <project-id>.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=

# firebaseConfig.projectId
VITE_FIREBASE_PROJECT_ID=

# firebaseConfig.appId
VITE_FIREBASE_APP_ID=

# Email của tài khoản admin: tạo ở Firebase Console → Authentication → Users → Add user
# (phải trùng email trong firestore.rules)
VITE_ADMIN_EMAIL=
